{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blue Browser",
  "version": "0.1.0",
  "identifier": "com.blue.browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Blue Browser",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "backgroundColor": "#05070f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://suggestqueries.google.com http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "A fast, private Chromium-based web browser",
    "longDescription": "Blue Browser is a modern glass-styled browser built on Tauri with built-in ad blocking, reader mode, vertical tabs and more.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "target/release/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Blue Browser"
      }
    }
  }
}
